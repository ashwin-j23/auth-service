# Server
NODE_ENV=development
PORT=4000

# Postgres (used by Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/auth_service?schema=public"

# JWT
JWT_ACCESS_SECRET="replace-with-a-long-random-value"
JWT_ACCESS_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=7

# Cookie signing (used for the OAuth CSRF state cookie)
COOKIE_SECRET="replace-with-a-long-random-value"

# Google OAuth (create credentials at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:4000/api/auth/google/callback"

# Where to send the browser after a successful Google login (a short-lived,
# single-use ?code= handoff is appended — see README.md's API section).
OAUTH_SUCCESS_REDIRECT_URL="http://localhost:3000/oauth/callback"

# Comma-separated allowlist of browser origins allowed to call this API
# (e.g. "https://app.example.com,https://admin.example.com"). Optional in
# development (falls back to reflecting any origin); required in production —
# see src/app.ts, which refuses all cross-origin requests rather than
# defaulting open if this is unset there.
# CORS_ALLOWED_ORIGINS="http://localhost:3000"
