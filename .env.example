# Server
NODE_ENV=development
PORT=4000

# Postgres (used by Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/auth_service?schema=public"

# JWT
JWT_ACCESS_SECRET="replace-with-a-long-random-value"
JWT_ACCESS_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=7
# Included as the iss/aud claims on every access token — leave the defaults
# unless another service needs to verify tokens issued by a specifically-named source.
# JWT_ISSUER="auth-service"
# JWT_AUDIENCE="auth-service"

# Cookie signing (used for the OAuth CSRF state cookie)
COOKIE_SECRET="replace-with-a-long-random-value"

# Google OAuth (create credentials at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:4000/api/auth/google/callback"

# Where to send the browser after a successful Google login (a short-lived,
# single-use ?code= handoff is appended — see README.md's API section).
OAUTH_SUCCESS_REDIRECT_URL="http://localhost:3000/oauth/callback"

# CORS: pick ONE. Both default to closed (no cross-origin requests allowed at
# all) — see src/app.ts. This is NOT tied to NODE_ENV, on purpose: whichever
# you pick has to be set explicitly, in every environment including local dev.
#
# Preferred — an explicit allowlist (works for the bundled project/frontend-test).
# Each origin must be scheme://host[:port] exactly — no path, no trailing
# slash (a real browser Origin header never has either); validated at boot.
CORS_ALLOWED_ORIGINS="http://localhost:3000"
# Alternative for local dev only, if your frontend's port changes often —
# reflects whatever Origin header a request sends, i.e. allows any origin:
# ALLOW_ANY_CORS_ORIGIN=true

# Set when running behind a reverse proxy/load balancer (nginx, an ALB, …) —
# otherwise req.ip (and therefore every per-IP rate limit) sees the proxy's
# IP for every request instead of the real client's. "1" = trust one hop.
# Leave unset for a direct-connection local setup. See:
# https://expressjs.com/en/guide/behind-proxies.html
# TRUST_PROXY=1

# Passed to express.json()'s `limit` option.
# JSON_BODY_LIMIT="10kb"

# Rate limiting — see src/middleware/rateLimit.middleware.ts. STRICT applies
# to signup/login; STANDARD to refresh/logout/google routes.
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_STRICT_MAX=30
# RATE_LIMIT_STANDARD_MAX=100

# Account-level login lockout (auth.service.ts) — independent of the per-IP
# rate limiting above. LOCKOUT_MAX_ATTEMPTS wrong passwords in a row locks
# that account for LOCKOUT_DURATION_MS, regardless of which IP they came from.
# LOCKOUT_MAX_ATTEMPTS=5
# LOCKOUT_DURATION_MS=900000

# Backstop cap on the in-memory Google-OAuth handoff store (oauthHandoff.service.ts)
# — see README.md's security notes for the tradeoff this involves.
# OAUTH_HANDOFF_MAX_ENTRIES=5000
