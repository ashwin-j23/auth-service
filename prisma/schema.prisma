// Prisma schema for the auth service.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  // Null for accounts created purely via Google OAuth (no password set).
  passwordHash    String?
  name            String?
  // Google's stable "sub" claim. Null until the account is linked to Google.
  googleId        String?   @unique
  isEmailVerified Boolean   @default(false)

  // Account-level login lockout (auth.service.ts). Reset to 0 / null on
  // every successful password login; incremented on every failed one.
  // Deliberately separate from any future admin-driven suspension —
  // this is a self-clearing, temporary throttle, not a permanent flag.
  failedLoginAttempts Int      @default(0)
  lockedUntil         DateTime?

  // Permanent, admin-driven account suspension (distinct from the
  // temporary lockout above) — checked in GET /me (auth.controller.ts).
  isActive        Boolean   @default(true)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  refreshTokens   RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id                  String    @id @default(uuid())
  // SHA-256 hash of the opaque refresh token. The raw value is only ever
  // returned to the client once and never persisted.
  tokenHash           String    @unique
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt           DateTime
  revokedAt           DateTime?
  // Hash of the token that replaced this one, set on rotation. Useful for
  // audit trails / reuse detection.
  replacedByTokenHash String?
  createdAt           DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}
