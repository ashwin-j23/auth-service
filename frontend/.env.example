# Base URL of the auth API (no trailing slash). Relative in dev so requests
# go through Vite's dev-server proxy (see vite.config.ts, which forwards
# /api/* to the backend's PORT=4000 default) rather than cross-origin
# straight to :4000 — in production point this at your deployed API instead,
# e.g. https://api.yourdomain.com/api/auth
VITE_API_BASE_URL=/api/auth
