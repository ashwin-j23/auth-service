# Vite loads this automatically for `vite build` (mode=production) — used
# by the Docker build (frontend/Dockerfile), which never sees the
# gitignored, dev-only .env. Relative on purpose: the production nginx
# config (nginx/conf.d/ashwin.opsmonsters.com.conf) proxies /api on the
# same origin the static frontend is served from, exactly like Vite's own
# dev-server proxy does locally — see vite.config.ts.
VITE_API_BASE_URL=/api/auth
